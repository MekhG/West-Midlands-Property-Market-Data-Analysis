import pandas as pd
import duckdb

df_housing = pd.read_excel('HouseBook.xlsx')
df_housing.head()

duckdb.query("""
CREATE OR REPLACE TABLE housing_clean AS
SELECT *,
       TRY_CAST(NULLIF(Value, '.') AS DOUBLE) AS Value_num
FROM df_housing
""")

duckdb.query("SELECT Value, Value_num FROM housing_clean LIMIT 20").to_df()


yearly_sales_sql = """
SELECT Year,
       SUM(Value_num) AS total_sales
FROM housing_clean
WHERE HouseSalesAndPrices = 'Count of sales'
GROUP BY Year
ORDER BY Year
"""
yearly_sales = duckdb.query(yearly_sales_sql).to_df()
print(yearly_sales)


mean_price_sql = """
SELECT Year,
       ROUND(AVG(Value_num),0) AS avg_mean_price
FROM housing_clean
WHERE HouseSalesAndPrices = 'Mean price'
GROUP BY Year
ORDER BY Year
"""
mean_price = duckdb.query(mean_price_sql).to_df()
print("\n Average mean price per year")
print(mean_price)



lower_quartile_sql = """
SELECT Year,
       ROUND(AVG(Value_num),0) AS avg_lower_quartile_price
FROM housing_clean
WHERE HouseSalesAndPrices = 'Lower quartile price'
GROUP BY Year
ORDER BY Year
"""
lower_quartile = duckdb.query(lower_quartile_sql).to_df()
print("\n Average lower quartile price per year")
print(lower_quartile)


median_price_sql = """
SELECT Year,
       ROUND(AVG(Value_num),0) AS avg_median_price
FROM housing_clean
WHERE HouseSalesAndPrices = 'Median price'
GROUP BY Year
ORDER BY Year
"""
median_price = duckdb.query(median_price_sql).to_df()
print("\n Median price trend")
print(median_price)



sales_growth_sql = """
SELECT Year,
       SUM(Value_num) AS total_sales,
       SUM(Value_num) - LAG(SUM(Value_num)) OVER (ORDER BY Year) AS yoy_growth
FROM housing_clean
WHERE HouseSalesAndPrices = 'Count of sales'
GROUP BY Year
ORDER BY Year
"""
sales_growth = duckdb.query(sales_growth_sql).to_df()
print("\n Year-over-year sales growth")
print(sales_growth)


mean_price_growth_sql = """
SELECT Year,
       ROUND(AVG(Value_num),0) AS avg_mean_price,
       (AVG(Value_num) - LAG(AVG(Value_num)) OVER (ORDER BY Year)) / LAG(AVG(Value_num)) OVER (ORDER BY Year) * 100 AS yoy_growth_pct
FROM housing_clean
WHERE HouseSalesAndPrices = 'Mean price'
GROUP BY Year
ORDER BY Year
"""
mean_price_growth = duckdb.query(mean_price_growth_sql).to_df()
print("\n Year-over-year mean price growth (%)")
print(mean_price_growth)



property_price_sql = """
SELECT PropertyType,
       HouseSalesAndPrices,
       ROUND(AVG(Value_num),0) AS avg_value
FROM housing_clean
WHERE HouseSalesAndPrices IN ('Mean price','Median price','Lower quartile price')
